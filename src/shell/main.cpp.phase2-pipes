#include <iostream>
#include <string>
#include <vector>
#include <sstream>
#include <unistd.h>
#include <sys/wait.h>
#include <sys/types.h>
#include <limits.h>
#include <cstdlib>
#include <cerrno>
#include <cctype>
#include <fcntl.h>
#include <cstring>

using namespace std;

vector<string> command_history;
string monitor_script;

// ==========================================
// 1. COMMAND PARSER
// ==========================================

vector<string> parse_command(const string& input) {
    vector<string> args;
    string current;
    char quote = '\0';
    bool escaping = false;
    bool token_started = false;

    for (char ch : input) {
        if (escaping) {
            current += ch;
            escaping = false;
            token_started = true;
        }
        else if (ch == '\\' && quote != '\'') {
            escaping = true;
            token_started = true;
        }
        else if (quote != '\0') {
            if (ch == quote) {
                quote = '\0';
            } else {
                current += ch;
            }
        }
        else if (ch == '"' || ch == '\'') {
            quote = ch;
            token_started = true;
        }
        else if (isspace(static_cast<unsigned char>(ch))) {
            if (token_started) {
                args.push_back(current);
                current.clear();
                token_started = false;
            }
        }
        else {
            current += ch;
            token_started = true;
        }
    }

    if (escaping) current += '\\';

    if (quote != '\0') {
        cerr << "ShellSense: unmatched quote\n";
        return {};
    }

    if (token_started) {
        args.push_back(current);
    }

    return args;
}

// ==========================================
// 2. PIPELINE PARSER
// ==========================================

vector<string> split_pipeline(const string& input) {
    vector<string> commands;
    string current;
    char quote = '\0';
    bool escaping = false;

    for (char ch : input) {
        if (escaping) {
            current += ch;
            escaping = false;
        }
        else if (ch == '\\' && quote != '\'') {
            current += ch;
            escaping = true;
        }
        else if (quote != '\0') {
            current += ch;

            if (ch == quote) quote = '\0';
        }
        else if (ch == '"' || ch == '\'') {
            quote = ch;
            current += ch;
        }
        else if (ch == '|') {
            if (current.find_first_not_of(" \t") == string::npos) {
                cerr << "ShellSense: empty pipeline command\n";
                return {};
            }

            commands.push_back(current);
            current.clear();
        }
        else {
            current += ch;
        }
    }

    if (quote != '\0' || escaping) {
        cerr << "ShellSense: incomplete quoted command\n";
        return {};
    }

    if (current.find_first_not_of(" \t") == string::npos) {
        cerr << "ShellSense: empty pipeline command\n";
        return {};
    }

    commands.push_back(current);
    return commands;
}

// ==========================================
// 3. HELP AND HISTORY
// ==========================================

void show_help() {
    cout << "\n========== ShellSense AI ==========\n";
    cout << "Built-in commands:\n";
    cout << "  help       Show help\n";
    cout << "  pwd        Current directory\n";
    cout << "  cd         Change directory\n";
    cout << "  history    Show command history\n";
    cout << "  sysinfo    System monitoring\n";
    cout << "  exit       Exit shell\n";
    cout << "\nExternal commands: ls, date, whoami, echo, etc.\n";
    cout << "Pipelines: command1 | command2\n";
    cout << "===================================\n\n";
}

void show_history() {
    for (size_t i = 0; i < command_history.size(); i++) {
        cout << i + 1 << ". " << command_history[i] << '\n';
    }
}

// ==========================================
// 4. EXTERNAL COMMAND EXECUTION
// ==========================================

void execute_external_command(const vector<string>& args) {
    if (args.empty()) return;

    vector<char*> argv;

    for (const string& arg : args) {
        argv.push_back(const_cast<char*>(arg.c_str()));
    }

    argv.push_back(nullptr);

    pid_t pid = fork();

    if (pid < 0) {
        perror("ShellSense: fork");
        return;
    }

    if (pid == 0) {
        execvp(argv[0], argv.data());

        perror("ShellSense: execvp");
        _exit(127);
    }

    int status;
    pid_t result;

    do {
        result = waitpid(pid, &status, 0);
    } while (result < 0 && errno == EINTR);

    if (result < 0) {
        perror("ShellSense: waitpid");
        return;
    }

    if (WIFEXITED(status)) {
        cout << "[Exit code: " << WEXITSTATUS(status) << "]\n";
    }
    else if (WIFSIGNALED(status)) {
        cout << "[Terminated by signal: "
             << WTERMSIG(status) << "]\n";
    }
}

// ==========================================
// 5. PIPELINE EXECUTION
// ==========================================

void execute_pipeline(const string& input) {
    vector<string> commands = split_pipeline(input);

    if (commands.size() < 2) return;

    vector<vector<string>> parsed_commands;

    for (const string& command : commands) {
        vector<string> args = parse_command(command);

        if (args.empty()) return;

        parsed_commands.push_back(args);
    }

    int previous_read = -1;
    vector<pid_t> children;

    for (size_t i = 0; i < parsed_commands.size(); i++) {
        int pipe_fd[2] = {-1, -1};

        bool has_next = (i + 1 < parsed_commands.size());

        if (has_next && pipe(pipe_fd) == -1) {
            perror("ShellSense: pipe");

            if (previous_read != -1) close(previous_read);

            return;
        }

        pid_t pid = fork();

        if (pid < 0) {
            perror("ShellSense: fork");

            if (previous_read != -1) close(previous_read);

            if (has_next) {
                close(pipe_fd[0]);
                close(pipe_fd[1]);
            }

            for (pid_t child : children) {
                waitpid(child, nullptr, 0);
            }

            return;
        }

        if (pid == 0) {
            // Connect previous pipe to standard input.
            if (previous_read != -1) {
                if (dup2(previous_read, STDIN_FILENO) == -1) {
                    perror("ShellSense: dup2 stdin");
                    _exit(1);
                }
            }

            // Connect current output to next pipe.
            if (has_next) {
                if (dup2(pipe_fd[1], STDOUT_FILENO) == -1) {
                    perror("ShellSense: dup2 stdout");
                    _exit(1);
                }
            }

            if (previous_read != -1) close(previous_read);

            if (has_next) {
                close(pipe_fd[0]);
                close(pipe_fd[1]);
            }

            vector<char*> argv;

            for (string& arg : parsed_commands[i]) {
                argv.push_back(arg.data());
            }

            argv.push_back(nullptr);

            execvp(argv[0], argv.data());

            perror("ShellSense: pipeline command");
            _exit(127);
        }

        children.push_back(pid);

        if (previous_read != -1) {
            close(previous_read);
        }

        if (has_next) {
            close(pipe_fd[1]);
            previous_read = pipe_fd[0];
        }
    }

    // Wait for all pipeline child processes.
    for (pid_t child : children) {
        int status;
        pid_t result;

        do {
            result = waitpid(child, &status, 0);
        } while (result < 0 && errno == EINTR);

        if (result < 0) {
            perror("ShellSense: waitpid");
        }
    }
}

// ==========================================
// 6. DIRECTORY MANAGEMENT
// ==========================================

void change_directory(const vector<string>& args) {
    string path;

    if (args.size() < 2 || args[1] == "~") {
        const char* home = getenv("HOME");

        if (home == nullptr) {
            cerr << "ShellSense: HOME is not set\n";
            return;
        }

        path = home;
    }
    else {
        path = args[1];

        if (path.rfind("~/", 0) == 0) {
            const char* home = getenv("HOME");

            if (home != nullptr) {
                path = string(home) + path.substr(1);
            }
        }
    }

    if (args.size() > 2) {
        cerr << "Usage: cd [directory]\n";
        return;
    }

    if (chdir(path.c_str()) != 0) {
        perror("ShellSense: cd");
    }
}

// ==========================================
// 7. SYSTEM INFORMATION
// ==========================================

void execute_sysinfo() {
    vector<string> args = {
        ".venv/bin/python",
        monitor_script
    };

    execute_external_command(args);
}

// ==========================================
// 8. MAIN SHELL
// ==========================================

int main() {
    char startup_directory[PATH_MAX];

    if (getcwd(startup_directory, sizeof(startup_directory)) == nullptr) {
        perror("ShellSense: getcwd");
        return 1;
    }

    monitor_script = string(startup_directory) +
                     "/src/monitor/sysinfo.py";

    string input;

    cout << "\n====================================\n";
    cout << "          ShellSense AI             \n";
    cout << "   Linux Shell & System Intelligence\n";
    cout << "====================================\n";
    cout << "Type 'help' to get started.\n\n";

    while (true) {
        char cwd[PATH_MAX];

        if (getcwd(cwd, sizeof(cwd)) != nullptr) {
            cout << "ShellSense:" << cwd << "$ ";
        }
        else {
            cout << "ShellSense$ ";
        }

        cout.flush();

        if (!getline(cin, input)) {
            cout << "\nExiting ShellSense AI...\n";
            break;
        }

        if (input.empty()) continue;

        // Detect pipeline before normal command parsing.
        if (input.find('|') != string::npos) {
            command_history.push_back(input);
            execute_pipeline(input);
            continue;
        }

        vector<string> args = parse_command(input);

        if (args.empty()) continue;

        command_history.push_back(input);

        const string& command = args[0];

        if (command == "exit") {
            cout << "Goodbye!\n";
            break;
        }
        else if (command == "help") {
            show_help();
        }
        else if (command == "pwd") {
            char current_directory[PATH_MAX];

            if (getcwd(current_directory, sizeof(current_directory))) {
                cout << current_directory << '\n';
            }
            else {
                perror("pwd");
            }
        }
        else if (command == "cd") {
            change_directory(args);
        }
        else if (command == "history") {
            show_history();
        }
        else if (command == "sysinfo") {
            execute_sysinfo();
        }
        else {
            execute_external_command(args);
        }
    }

    return 0;
}
